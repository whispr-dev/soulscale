# Copy to .env (same folder as Cargo.toml) and fill in. Never commit .env.
# The server reads it on start; real environment variables win over this file.

# --- Discord (Developer Portal → your app → OAuth2) -----------------------------
# Client ID is public (the browser gets it from /api/config).
DISCORD_CLIENT_ID=
# Client Secret is private: it stays on the server and is used to swap the login code
# for a token. Leave it empty to run in browser test mode only.
DISCORD_CLIENT_SECRET=
# Optional (Bot → Reset Token). Lets the server confirm the Activity instance a player
# claims to be in really exists, so nobody can join a room they aren't in.
DISCORD_BOT_TOKEN=

# --- Server ----------------------------------------------------------------------
# Where to listen. Keep 127.0.0.1 behind a tunnel or reverse proxy.
SOULSCALE_BIND=127.0.0.1:3001
# Built client (npm run build in client/).
SOULSCALE_STATIC_DIR=client/dist
# Saved logs, CSVs and replays go in <data>/replays/.
SOULSCALE_DATA_DIR=data
# Browser test logins (?name=Bob). Default: on when no client secret is set, off otherwise.
# Set to "off" in production, or "on" to keep them alongside Discord while testing.
SOULSCALE_DEV_LOGIN=
# A player who doesn't act within this many seconds gets an automatic play.
SOULSCALE_TURN_TIMEOUT_SECS=120
# A Duel player who disconnects is covered by the AI after this many seconds.
SOULSCALE_RECONNECT_GRACE_SECS=30

# Log detail: error, warn, info, debug, trace (per module works too).
RUST_LOG=info
