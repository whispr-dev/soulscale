{
  "name": "soulscale-client",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Soulscale Discord Activity client (talks to soulscale-server over WebSocket)",
  "scripts": {
    "glyphs": "node scripts/copy-glyphs.mjs",
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "@discord/embedded-app-sdk": "2.5.0",
    "@fontsource/cinzel": "5.3.0",
    "@fontsource/cormorant-garamond": "5.3.0"
  },
  "devDependencies": {
    "@twemoji/svg": "15.0.0",
    "typescript": "7.0.2",
    "vite": "8.3.7"
  }
}
